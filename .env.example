# Copy to .env and fill in. Never commit .env.
# The integration tests (npm run test:integration) use the first complete login below.

# The API version, e.g. v66.0 (66.0 works too). Required.
SF_API_VERSION=

# 1. Client credentials. SF_LOGIN_URL is your My Domain URL, e.g. https://mydomain.my.salesforce.com
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# 2. Access token (e.g. from `sf org auth show-access-token --json`). Expires with the session.
SF_ACCESS_TOKEN=
SF_INSTANCE_URL=

# 3. Salesforce CLI: an alias or username you are logged into with `sf`.
#    When set next to 1 or 2, the sfCli login is tested as well.
SF_TARGET_ORG=

# Create the test fixtures (platform event, Apex classes, report) in orgs other than
# Developer Edition orgs and sandboxes. Never point this at production.
# SF_IT_SETUP=1
